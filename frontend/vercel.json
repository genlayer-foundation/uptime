{
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/appeals",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/settle",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/alerts/digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/alerts/bounces",
      "schedule": "30 */6 * * *"
    }
  ]
}

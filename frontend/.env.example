# Heartbeat contract on Bradbury (contracts/heartbeat.py, deployed with the
# fixture base URL https://<this site>/heartbeat as its constructor argument)
HEARTBEAT_CONTRACT=0x...

# Server-side wallet that owns the contract and pays for every probe and the
# appeal bonds. Must be the deployer: probes are owner-only.
PRIVATE_KEY=0x...

# Vercel KV / Upstash Redis — pending txs and graded results
KV_REST_API_URL=
KV_REST_API_TOKEN=

# REQUIRED: cron routes refuse every call without it (a tick spends gas)
CRON_SECRET=

# Optional tuning
HEARTBEAT_LLM_PER_TICK=2
HEARTBEAT_APPEAL_EVERY=6

# Dev only (`next dev`): where /api/heartbeat reads from. Ignored in any build,
# which always reads KV. demo = synthetic, production = proxy the public
# endpoint (no secrets), local = KV above. Default under next dev: demo.
# HEARTBEAT_DATA_SOURCE=demo

# Jobs UI. 1 = answer every /api/jobs, /api/auth, /api/me, /api/presets call from
# an in-browser mock (src/lib/jobs/mock.ts) with sample jobs and runs; sign-in
# and pool calls are simulated and never touch a real wallet. Never set in prod.
# NEXT_PUBLIC_JOBS_MOCK=1
# UptimePool on Bradbury (contracts/evm/src/UptimePool.sol). Unset = not deployed;
# the funding UI says so.
# NEXT_PUBLIC_UPTIME_POOL_BRADBURY=0x...

# Heartbeat contract on Bradbury (contracts/heartbeat.py, deployed with the
# fixture base URL https://<this site>/heartbeat as its constructor argument)
HEARTBEAT_CONTRACT=0x...

# Server-side wallet that owns the contract and pays for every probe and the
# appeal bonds. Must be the deployer: probes are owner-only.
PRIVATE_KEY=0x...

# Heartbeat results live in Postgres (DATABASE_URL, below). Upstash KV is only a
# fallback for a server without DATABASE_URL (or before migrations 011 + 013).
# Leave empty otherwise.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# REQUIRED: cron routes refuse every call without it (a tick spends gas)
CRON_SECRET=

# Dev only (`next dev`): where /api/heartbeat reads from. Ignored in any build,
# which always reads the real store. demo = synthetic, production = proxy the
# public endpoint (no secrets), local = Postgres (or KV above). Default under next dev: demo.
# HEARTBEAT_DATA_SOURCE=demo

# Jobs UI. 1 = answer every /api/jobs, /api/auth, /api/me, /api/presets call from
# an in-browser mock (src/lib/jobs/mock.ts) with sample jobs and runs; sign-in
# and pool calls are simulated and never touch a real wallet. Never set in prod.
# NEXT_PUBLIC_JOBS_MOCK=1

# ---- Jobs (generic paid cron) ------------------------------------------------
# NOT AUDITED, TESTNET ONLY. Do not deposit anything you can't lose.

# Postgres (local: postgres://localhost/uptime_dev; prod: Neon via Vercel).
# Without it the jobs API answers 503 and the Heartbeat keeps its legacy cron.
DATABASE_URL=
# Signs the wallet session cookie. REQUIRED for sign-in; >= 32 random chars.
SESSION_SECRET=

# Wallet lists, comma-separated addresses (any case). Unset or empty = nobody.
# Studio is only for pre-approved GenLayer Labs + Foundation wallets.
STUDIO_ALLOWLIST=
# Operators: may list all jobs and pause any job.
UPTIME_ADMIN_WALLETS=

# Relayer keys that sign scheduled runs. Bradbury falls back to PRIVATE_KEY.
RELAYER_KEY_STUDIO=
RELAYER_KEY_BRADBURY=

# Generic preset contracts (contracts/web_probe.py, contracts/ask.py), per network.
UPTIME_WEBPROBE_STUDIO=
UPTIME_WEBPROBE_BRADBURY=
UPTIME_ASK_STUDIO=
UPTIME_ASK_BRADBURY=

# Bradbury UptimePool (contracts/evm). Same address in both: the server reads
# UPTIME_POOL_BRADBURY, the browser (deposit/withdraw) NEXT_PUBLIC_UPTIME_POOL_BRADBURY.
UPTIME_POOL_BRADBURY=
NEXT_PUBLIC_UPTIME_POOL_BRADBURY=
# Plain EVM RPC for the pool (default https://rpc.testnet-chain.genlayer.com)
# BRADBURY_EVM_RPC=
# Batched pool charging. OFF unless exactly "1".
POOL_CHARGING_ENABLED=0
# Flat per-tx cost recorded on Bradbury step runs, in wei, until fees are measured.
UPTIME_RUN_COST_WEI=0
# Studio quota (the Foundation pays Studio's LLM calls)
# STUDIO_MAX_JOBS_PER_WALLET=10
